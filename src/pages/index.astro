		<script>
			import gsap from 'gsap';

			// Entrada a medida del <h1> de la diapositiva 1: en vez del fundido
			// genérico por palabra (ver "[data-titulo-parte]" más abajo, excluido
			// a propósito de ese mecanismo), cada pieza entra desde un sitio
			// distinto -Impulsa desde la izquierda, Ohkey desde la derecha,
			// Digital cayendo desde arriba- pero EN EL ORDEN DE LECTURA de la
			// frase (Impulsa → tu → negocio → con → Ohkey → Digital), una
			// detrás de otra sin solaparse, para que se pueda leer según entra
			// en vez de aparecer todo a la vez o en un orden que no es el de
			// la frase.
			//
			// Va en un <script> aparte y ANTES del motor del slider a propósito:
			// ese motor llama a "gotoSection(0, 1)" -que dispara "slide:enter"- de
			// forma síncrona en cuanto termina de definirse, así que el listener
			// de aquí abajo tiene que existir ANTES de que ese script se ejecute,
			// o se pierde el disparo de la primera carga (los <script> de Astro
			// son módulos y corren en el orden del documento).
			//
			// Sin bandera de "ya se reprodujo", igual que el resto de entradas de
			// esta diapositiva: puede visitarse varias veces y cada una vuelve a
			// animar desde cero (el punto de partida se fija con "gsap.set" justo
			// antes de cada reproducción).
			const impulsa = document.querySelector<SVGElement>('[data-titulo-parte="impulsa"]');
			const filaCentral = gsap.utils.toArray<HTMLElement>('[data-titulo-parte="fila"]');
			const ohkey = document.querySelector<SVGElement>('[data-titulo-parte="ohkey"]');
			const digital = document.querySelector<HTMLElement>('[data-titulo-parte="digital"]');
			// Regla de acento lima bajo el título (ver el <div> con esta misma
			// marca más arriba): no es parte del título en sí, pero entra en la
			// MISMA timeline, encadenada al final, para que se dibuje justo
			// después de que termina de entrar la última pieza ("digital").
			const accent = document.querySelector<HTMLElement>('[data-titulo-parte="accent"]');

			const parrafoIntro = document.querySelector<HTMLElement>('[data-mecanografiado="intro"]');
			const caracteresIntro = parrafoIntro ? gsap.utils.toArray<HTMLElement>('.caracter', parrafoIntro) : [];
			const cursorIntro = parrafoIntro?.querySelector<HTMLElement>('[data-cursor-mecanografiado]') ?? null;
			const notaClases = document.querySelector<HTMLElement>('[data-nota-clases]');
			const ctaIntro = document.getElementById('cta-servicios');
			const PASO_MECANOGRAFIADO = 0.032;
			const PAUSA_ANTES_DE_ESCRIBIR = 0.6;

			// La entrada del título y el mecanografiado solo se ven la primera
			// vez que se visita esta diapositiva: en visitas siguientes resultan
			// pesadas de esperar para quien ya las vio, así que directamente se
			// deja todo en su estado final sin animar nada.
			let yaAnimadoIntro = false;
			let tlIntroActual: gsap.core.Timeline | null = null;

			// Estado final de la entrada del titular, sin animar: lo usan tanto
			// una visita repetida a esta diapositiva (más abajo) como el salto
			// manual de la intro (evento "intro:skip", ver ShapeOverlays.astro) -
			// mismo código, dos disparadores distintos.
			function mostrarTituloIntroFinal(): void {
				tlIntroActual?.kill();
				if (!impulsa || !ohkey || !digital) return;
				gsap.set([impulsa, ohkey, ...filaCentral, digital], {
					autoAlpha: 1,
					xPercent: 0,
					yPercent: 0,
					rotation: 0,
					scale: 1,
				});
				if (accent) gsap.set(accent, { autoAlpha: 1, scaleX: 1 });
				if (notaClases) gsap.set(notaClases, { autoAlpha: 1, scale: 1 });
				if (ctaIntro) gsap.set(ctaIntro, { autoAlpha: 1, yPercent: 0 });
				gsap.set(caracteresIntro, { visibility: 'visible' });
				if (cursorIntro && parrafoIntro) {
					gsap.set(cursorIntro, { autoAlpha: 1 });
					parrafoIntro.append(cursorIntro);
				}
			}

			function playTituloIntro(): void {
				if (!impulsa || !ohkey || !digital || filaCentral.length === 0) return;

				if (yaAnimadoIntro) {
					mostrarTituloIntroFinal();
					return;
				}

				yaAnimadoIntro = true;

				gsap.set(impulsa, { autoAlpha: 0, xPercent: -60, rotation: -10 });
				gsap.set(ohkey, { autoAlpha: 0, xPercent: 60, rotation: 10 });
				gsap.set(filaCentral, { autoAlpha: 0, yPercent: 70, scale: 0.5 });
				gsap.set(digital, { autoAlpha: 0, yPercent: -140, rotation: -25 });
				if (accent) gsap.set(accent, { autoAlpha: 0, scaleX: 0, transformOrigin: 'left center' });
				if (notaClases) gsap.set(notaClases, { autoAlpha: 0, scale: 0.6, transformOrigin: 'bottom left' });
				if (ctaIntro) gsap.set(ctaIntro, { autoAlpha: 0, yPercent: 20 });
				if (cursorIntro && parrafoIntro) parrafoIntro.prepend(cursorIntro);
				if (cursorIntro) gsap.set(cursorIntro, { autoAlpha: 0 });
				gsap.set(caracteresIntro, { visibility: 'hidden' });

				// El "delay" espera a que el barrido de la diapositiva (ver
				// "DURACION" en el motor del slider, más abajo) haya despejado
				// pantalla antes de arrancar: sin él, la entrada corría a la vez
				// que la transición y quedaba tapada/ilegible.
				const tl = gsap.timeline({ delay: 0.5, defaults: { ease: 'back.out(1.7)' } });
				tlIntroActual = tl;

				// Sin parámetro de posición: cada ".to" se encadena al FINAL del
				// anterior (incluido su propio stagger), así que el orden en el
				// que se escriben aquí es el orden en el que se ven -el de la
				// frase-, sin que ninguna se solape con la siguiente. La regla de
				// acento va la ÚLTIMA a propósito: se dibuja de izquierda a
				// derecha (scaleX) solo cuando el título ya ha terminado de entrar.
				tl.to(impulsa, { autoAlpha: 1, xPercent: 0, rotation: 0, duration: 0.45 })
					.to(filaCentral, { autoAlpha: 1, yPercent: 0, scale: 1, duration: 0.35, stagger: 0.15 })
					.to(ohkey, { autoAlpha: 1, xPercent: 0, rotation: 0, duration: 0.45 })
					.to(digital, { autoAlpha: 1, yPercent: 0, rotation: 0, duration: 0.45 });

				if (accent) tl.to(accent, { autoAlpha: 1, scaleX: 1, duration: 0.35, ease: 'power2.out' });

				if (notaClases) tl.to(notaClases, { autoAlpha: 1, scale: 1, duration: 0.5 });

				if (cursorIntro) tl.set(cursorIntro, { autoAlpha: 1 });
				tl.to({}, { duration: PAUSA_ANTES_DE_ESCRIBIR });

				caracteresIntro.forEach((caracter) => {
					tl.set(caracter, { visibility: 'visible' }, `+=${PASO_MECANOGRAFIADO}`).call(() => {
						if (cursorIntro) caracter.insertAdjacentElement('afterend', cursorIntro);
					});
				});

				if (ctaIntro) tl.to(ctaIntro, { autoAlpha: 1, yPercent: 0, duration: 0.5 });
			}

			window.addEventListener('slide:enter', ((e: CustomEvent<{ index: number }>) => {
				if (e.detail.index === 0) playTituloIntro();
			}) as EventListener);

			// Clic en la cortina de entrada (ver ShapeOverlays.astro): salta
			// directamente al estado final de esta entrada, sin esperar a que
			// termine su propia animación.
			window.addEventListener('intro:skip', () => {
				yaAnimadoIntro = true;
				mostrarTituloIntroFinal();
			});
		</script>

		<script>
			import gsap from 'gsap';
			import { Observer } from 'gsap/Observer';

			gsap.registerPlugin(Observer);

			// Duración y paralaje calcados del motor de referencia
			// (project-crm/apps/web MotorDiapositivas.astro), que es la misma
			// mecánica de la demo "Swipe Slider" de GSAP ya probada en producción.
			const DURACION = 1.1;
			const PARALAJE = 15;

			const sections = gsap.utils.toArray<HTMLElement>('.slide');
			const outers = gsap.utils.toArray<HTMLElement>('.slide__outer');
			const inners = gsap.utils.toArray<HTMLElement>('.slide__inner');
			const backgrounds = gsap.utils.toArray<HTMLElement>('.slide__bg');

			// Color de reposo de cada fondo (el morado de la diapositiva 1, el
			// negro de la 2), leído del CSS antes de que GSAP empiece a
			// tocarlo. Sirve para que la transición funda uno con otro a
			// través del negro en vez de cortar de golpe entre los dos.
			const restColors = backgrounds.map((el) => getComputedStyle(el).backgroundColor);

			let currentIndex = -1;
			let animating = false;

			// La última diapositiva pedida mientras había una animación en curso.
			// Sin esto, un segundo gesto que llega dentro de esos ~1.1s se pierde
			// en silencio: se guarda y se atiende justo al terminar la actual.
			let pending: number | null = null;

			// ¿Ya cambió de diapositiva el gesto que se está haciendo? Un dedo
			// apoyado (touch/pointer) entrega el recorrido a trozos, así que sin
			// esta bandera un solo deslizamiento largo avanza varias diapositivas
			// de golpe. La rueda, en cambio, sí se raciona un giro = una diapositiva.
			let gestureConsumed = false;

			// "sections" ya no se traslada: solo alterna visibilidad/z-index (ver
			// abajo). El movimiento entero corre por cuenta de "outers"/"inners":
			// dos envoltorios, cada uno con "overflow: hidden", que se desplazan
			// en sentidos opuestos y la MISMA cantidad. Sin ese overflow-hidden,
			// las dos transformaciones se cancelarían matemáticamente en todo
			// instante (no solo al principio y al final) y el contenido se vería
			// ya colocado en su posición final desde el primer fotograma, sin
			// ningún desplazamiento visible. Con él, cada envoltorio recorta lo
			// que hay dentro a su propio marco, que a su vez se está moviendo:
			// eso es lo que convierte la cancelación matemática en una ventana
			// que barre la pantalla revelando el contenido, en vez de un simple
			// cambio de opacidad.
			gsap.set(sections, { autoAlpha: 0, zIndex: 0 });
			gsap.set(outers, { yPercent: 100 });
			gsap.set(inners, { yPercent: -100 });

			function gotoSection(indexRaw: number, direction: 1 | -1): void {
				// Se topa en los extremos en vez de dar la vuelta: con "wrap",
				// bajar en la última diapositiva volvía a la primera y se sentía
				// como un scroll infinito sin fin. "clamp" simplemente no avanza
				// más allá del principio o el final.
				const index = gsap.utils.clamp(0, sections.length - 1, indexRaw);

				if (index === currentIndex) return;

				if (animating) {
					pending = index;
					return;
				}

				animating = true;

				const dFactor = direction === -1 ? -1 : 1;

				const tl = gsap.timeline({
					defaults: { duration: DURACION, ease: 'power2.inOut' },
					onComplete: () => {
						animating = false;

						const next = pending;
						pending = null;

						if (next !== null) gotoSection(next, next > currentIndex ? 1 : -1);
					},
				});

				if (currentIndex >= 0) {
					// La diapositiva saliente pasa al fondo de inmediato y su fondo
					// (no su contenido: ver ".slide__bg" más abajo) se desplaza con
					// un ligero efecto parallax mientras su color se apaga hasta
					// negro puro -en vez de cortar de golpe a su color de reposo-,
					// y termina oculta de verdad (autoAlpha) para que no se quede
					// pintada por debajo ni pueda recibir clics.
					gsap.set(sections[currentIndex], { zIndex: 0 });
					tl.to(
						backgrounds[currentIndex],
						{ yPercent: -PARALAJE * dFactor, backgroundColor: '#000000' },
						0,
					).set(sections[currentIndex], { autoAlpha: 0 });
				}

				// La diapositiva entrante pasa al frente y su ventana (outer +
				// inner) se desliza desde arriba o abajo según la dirección del
				// gesto (rueda/touch), revelando el contenido a medida que
				// avanza. Su fondo, aparte, entra con un ligero parallax propio
				// (no el mismo desplazamiento que el contenido) y arranca en
				// negro puro para ir aclarándose hasta su color de reposo: es lo
				// que hace que el barrido se sienta como una ventana con
				// profundidad, y que el cambio entre morado y negro se vea como
				// un mismo tono fundiéndose en vez de un corte entre dos colores.
				gsap.set(sections[index], { autoAlpha: 1, zIndex: 1 });
				tl.fromTo(
					[outers[index], inners[index]],
					{ yPercent: (i: number) => (i ? -100 * dFactor : 100 * dFactor) },
					{ yPercent: 0 },
					0,
				).fromTo(
					backgrounds[index],
					{ yPercent: PARALAJE * dFactor, backgroundColor: '#000000' },
					{ yPercent: 0, backgroundColor: restColors[index] },
					0,
				);

				// El contenido entra CON la diapositiva, no después: el titular se
				// parte en palabras en la construcción (ver Titular.astro) y esas
				// palabras se animan dentro de esta misma timeline, superpuestas
				// con el propio desplazamiento de la diapositiva.
				//
				// El punto de partida se fija con "gsap.set" y no con "fromTo": un
				// "fromTo" anidado en una timeline solo re-renderiza su estado
				// inicial la primera vez que se llama con esas palabras: al volver a
				// una diapositiva ya vista, esos spans conservaban el "autoAlpha: 1"
				// de la vez anterior y el texto aparecía entero en vez de entrar
				// escalonado. Fijando el punto de partida a mano, cada visita
				// arranca siempre desde cero.
				// "[data-titulo-parte]" son las piezas del <h1> de la diapositiva 1
				// (Impulsa/fila central/Ohkey/Digital): tienen su propia entrada a
				// medida más abajo, no la genérica de aquí.
				// "if (words.length > 0)": hoy en día TODAS las ".palabra" de las
				// 2 diapositivas tienen su propia coreografía a medida (ver
				// "[data-titulo-parte]" arriba), así que este selector no
				// encuentra nada -GSAP avisa por consola de un target vacío en
				// cada cambio de diapositiva, sin más efecto-. Se deja la
				// guarda en vez de borrar el mecanismo: sigue siendo el
				// fundido genérico que recibiría cualquier palabra suelta que
				// se añada más adelante sin coreografía propia.
				const words = sections[index].querySelectorAll('.palabra:not([data-titulo-parte])');
				if (words.length > 0) {
					gsap.set(words, { autoAlpha: 0, yPercent: 120 * dFactor });
					tl.to(
						words,
						{
							autoAlpha: 1,
							yPercent: 0,
							duration: 0.9,
							ease: 'power2',
							stagger: { each: 0.03, from: 'random' },
						},
						0.15,
					);
				}

				currentIndex = index;

				// Permite que cada diapositiva dispare su propia animación de
				// entrada (p. ej. las tarjetas arrastrables de la diapositiva 2)
				// sincronizada con esta misma transición, no como algo aparte que
				// llega después.
				window.dispatchEvent(new CustomEvent('slide:enter', { detail: { index, direction } }));
			}

			function onGesture(self: Observer, direction: 1 | -1): void {
				// Un arrastre (touch/pointer) se raciona; la rueda no, porque cada
				// giro es un gesto suelto y no un recorrido continuo.
				const isDrag = self.event.type !== 'wheel';

				if (isDrag && gestureConsumed) return;

				gestureConsumed = isDrag;
				gotoSection(currentIndex + direction, direction);
			}

			Observer.create({
				target: window,
				type: 'wheel,touch,pointer',
				wheelSpeed: -1,
				tolerance: 10,
				preventDefault: true,
				// Sin esto, arrastrar una tarjeta de la diapositiva 2 (Draggable, en
				// DraggableHero.astro) también cuenta como gesto de cambio de
				// diapositiva para este Observer, que escucha en toda la ventana: el
				// mismo movimiento lo interpretaban los dos a la vez, y a veces
				// ganaba el slider en mitad del arrastre. "ignore" hace que el
				// Observer descarte por completo cualquier gesto que empiece sobre
				// una tarjeta, dejándoselo entero a Draggable.
				ignore: '[data-draggable-card], [data-card-modal]',
				// Un gesto nuevo empieza sin gastar. No puede ir en "onDragStart":
				// Observer lo llama después del primer "onUp" del mismo gesto.
				onPress: () => {
					gestureConsumed = false;
				},
				onDown: (self) => onGesture(self, -1),
				onUp: (self) => onGesture(self, 1),
			});

			function onKeydown(event: KeyboardEvent): void {
				// El modal de información de la diapositiva 2 (DraggableHero.astro)
				// también usa flechas/Home/End dentro de su propio contenido; con el
				// modal abierto, esas teclas no deben además cambiar de diapositiva
				// por debajo.
				if (document.body.classList.contains('modal-open')) return;

				const jump: Record<string, () => void> = {
					ArrowDown: () => gotoSection(currentIndex + 1, 1),
					PageDown: () => gotoSection(currentIndex + 1, 1),
					ArrowUp: () => gotoSection(currentIndex - 1, -1),
					PageUp: () => gotoSection(currentIndex - 1, -1),
					Home: () => gotoSection(0, -1),
					End: () => gotoSection(sections.length - 1, 1),
				};

				const action = jump[event.key];
				if (!action) return;

				event.preventDefault();
				action();
			}

			document.addEventListener('keydown', onKeydown);

			// El CTA de la diapositiva 1 lleva directamente a Servicios.
			document.getElementById('cta-servicios')?.addEventListener('click', (e) => {
				e.preventDefault();
				gotoSection(1, 1);
			});

			// Color del logo (ver <header> más arriba): el wordmark usa un
			// azul marino oscuro que se funde con el fondo negro de la
			// diapositiva 2 -el check/degradado no lleva la clase
			// "logo-mark-fill", así que no le afecta-. "data-slide" en
			// <body> es la única señal que necesita el CSS (ver
			// global.css) para decidir el color; mismo patrón que ya usa
			// "modal-open" para el modal de la diapositiva 2.
			window.addEventListener('slide:enter', ((e: CustomEvent<{ index: number }>) => {
				document.body.dataset.slide = String(e.detail.index);
			}) as EventListener);

			// Muestra la primera diapositiva al cargar la página.
			gotoSection(0, 1);
		</script>
	</body>
</html>
