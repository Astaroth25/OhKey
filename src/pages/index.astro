---
import '../styles/global.css';
import ShapeOverlays from '../components/ShapeOverlays.astro';
import DraggableHero from '../components/DraggableHero.astro';
import Mecanografiado from '../components/Mecanografiado.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import { WHATSAPP_NUMBER } from '../lib/whatsapp';

const title = 'OhKey Digital — Marketing, Software y Asesoría para tu Negocio';
const description =
	'Agencia de marketing digital para pequeños negocios en Ecuador y Latinoamérica: pautaje en Meta Ads, Google Ads y TikTok Ads, asesoría estratégica, desarrollo de software y cursos en vivo. Presupuestos pequeños, estrategia real.';
const canonicalUrl = new URL('/', Astro.site).toString();

const faqs = [
	{
		pregunta: '¿Qué servicios ofrece OhKey Digital?',
		respuesta:
			'Cuatro servicios bajo un mismo equipo: pautaje y contenido para redes (Meta Ads, Google Ads y TikTok Ads), asesoría estratégica, desarrollo de software (webs, apps y automatización con IA) y cursos en vivo de marketing digital, publicidad y AI.',
	},
	{
		pregunta: '¿OhKey Digital funciona con presupuestos pequeños?',
		respuesta:
			'Sí. OhKey diseña estrategias a la medida de lo que un negocio pequeño puede invertir realmente, sin consejos genéricos ni el gasto de una agencia de nivel empresarial.',
	},
	{
		pregunta: '¿Los cursos de OhKey son en vivo o pregrabados?',
		respuesta: 'Son cursos 100% en vivo y online, con contenido siempre actualizado, no clases pregrabadas.',
	},
	{
		pregunta: '¿Cómo se contacta a OhKey Digital?',
		respuesta:
			'Por WhatsApp directamente desde el sitio para cada servicio, o a través del canal de YouTube youtube.com/@dani.ohkey.digital.',
	},
	{
		pregunta: '¿Dónde opera OhKey Digital?',
		respuesta: 'Atiende negocios hispanohablantes en Ecuador y el resto de Latinoamérica.',
	},
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfessionalService',
			'@id': `${canonicalUrl}#organizacion`,
			name: 'OhKey Estrategias Digitales',
			alternateName: 'OhKey Digital',
			url: canonicalUrl,
			description,
			slogan: 'Con presupuestos pequeños y cerebro.',
			telephone: `+${WHATSAPP_NUMBER}`,
			areaServed: ['Ecuador', 'Latinoamérica'],
			sameAs: ['https://www.youtube.com/@dani.ohkey.digital'],
			makesOffer: [
				{
					'@type': 'Offer',
					itemOffered: {
						'@type': 'Service',
						name: 'Pautaje y contenido para redes',
						description: 'Meta Ads, Google Ads y TikTok Ads optimizados para generar resultados, no solo alcance.',
					},
				},
				{
					'@type': 'Offer',
					itemOffered: {
						'@type': 'Service',
						name: 'Asesoría estratégica',
						description: 'Estrategia hecha a la medida del negocio, con un plan de acción claro y accionable.',
					},
				},
				{
					'@type': 'Offer',
					itemOffered: {
						'@type': 'Service',
						name: 'Desarrollo de Software',
						description: 'Sitios web, aplicaciones y automatización de procesos con IA.',
					},
				},
				{
					'@type': 'Offer',
					itemOffered: {
						'@type': 'Service',
						name: 'Cursos y formación',
						description: 'Cursos en vivo y online de marketing digital, publicidad y AI, con contenido siempre actualizado.',
					},
				},
			],
		},
		{
			'@type': 'FAQPage',
			'@id': `${canonicalUrl}#faq`,
			mainEntity: faqs.map((faq) => ({
				'@type': 'Question',
				name: faq.pregunta,
				acceptedAnswer: { '@type': 'Answer', text: faq.respuesta },
			})),
		},
	],
};
---

<html lang="es" class="h-full">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="OhKey Estrategias Digitales" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="es_EC" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<!--
			"Kaushan Script": la cursiva de "negocio" en el titular de la
			diapositiva 2 (ver DraggableHero.astro). Reemplaza a "Amsterdam"
			-una fuente de descarga suelta que llegó a /public de licencia
			"personal use only"-: esta es de Google Fonts, gratis para uso
			comercial, y visualmente es la que más se le parece de las que
			probé.
		-->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Kaushan+Script&display=swap" rel="stylesheet" />
	</head>
	<body class="h-dvh w-dvw overflow-hidden overscroll-none bg-white">
		<!--
			Intro de entrada: cortina de shape-overlays con GSAP. Se ejecuta
			una vez al cargar y se auto-elimina del DOM al terminar,
			revelando el fondo interactivo y el slider.
		-->
		<ShapeOverlays />

		<div class="sr-only">
			<p>{description}</p>
			<h2>Preguntas frecuentes</h2>
			<dl>
				{faqs.map((faq) => (
					<>
						<dt>{faq.pregunta}</dt>
						<dd>{faq.respuesta}</dd>
					</>
				))}
			</dl>
		</div>

		<header class="pointer-events-none fixed top-6 left-6 z-30 px-4 py-2.5" data-brand-chrome>
			<svg class="h-15 w-auto" role="img" aria-label="OhKey Estrategias Digitales" version="1.2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 203 72" width="203" height="72"><defs><linearGradient id="P" gradientUnits="userSpaceOnUse"/><linearGradient id="g1" x2="1" href="#P" gradientTransform="matrix(227.83,0,0,141.369,60.08,21.3)"><stop stop-color="#633bff"/><stop offset=".22" stop-color="#775cfe"/><stop offset=".69" stop-color="#abb0fc"/><stop offset="1" stop-color="#cfebfb"/></linearGradient></defs><path class="logo-mark-fill" d="m137.6 16.3c9.1-2.9 18.7 0.1 20.6 12.4 0.2 1 0.5 3.2 0.5 4.1l-25.3 7.8c1.7 3.8 5.5 5.6 11.4 3.8 4-1.3 7.8-3.7 11.5-8l1.4 10.8c-3.2 2.8-6.9 5-12.7 6.8-12.6 3.9-21.4-2.3-23.1-12.9-1.7-11 3.8-21.1 15.7-24.8zm9.5 14c-0.9-4.6-4.2-6.3-7.9-5.1-5.1 1.6-6.7 5.5-6.7 9.6z"/><path class="logo-mark-fill" d="m202.1 17.5l-32.8 51h-12.7l11.7-16.7-9.1-34.3h12.8l3.7 16.5c0.5 2.2 0.7 3.7 0.4 9.3 1.7-5.6 2.4-7.1 3.7-9.3l9.6-16.5c0 0 12.7 0 12.7 0zm-128.1-1.2c-6.3 0-9.7 2.8-15.2 10.7l1.8-3.4c1.2-2.3 1.8-3.9 2.2-6.3l3-17.2h-11.5l-1.5 8.2c4.1 5.1 5.7 12.1 4.6 19.8-1.2 8.8-5.5 16.1-11.8 21.1l-0.8 4.2h11.6l3.1-17.4c1.3-7.1 5.3-9.3 8.3-9.3 2.8 0 5.8 1.8 4.9 7l-3.5 19.7h11.6l3.7-20.9c1.9-10.8-2.9-16.2-10.5-16.2zm-51.3 49.2q0.2 0.9 0.9 1.5 0.7 0.5 1.7 0.5 1.5 0 2.1-1.1l1.1 0.6q-1.1 1.7-3.2 1.7-1.7 0-2.8-1.1-1.1-1.1-1.1-2.7 0-1.7 1.1-2.7 1-1.1 2.7-1.1c1.7 0 1.9 0.4 2.6 1.1q1 1.1 1 2.7 0 0.3 0 0.6zm2.4-3.2q-1 0-1.6 0.5-0.7 0.6-0.8 1.6h4.8q-0.2-1.1-0.8-1.6c-0.7-0.5-1-0.5-1.6-0.5zm5.8 0.9q0 0.4 0.4 0.7 0.4 0.2 1 0.4 0.6 0.2 1.2 0.3 0.6 0.2 1 0.7 0.4 0.5 0.4 1.2 0 1-0.8 1.6-0.7 0.6-1.9 0.6-1.1 0-1.8-0.5-0.8-0.4-1.1-1.2l1.1-0.6q0.2 0.5 0.7 0.8 0.4 0.3 1.1 0.3 0.6 0 1-0.3 0.4-0.2 0.4-0.7 0-0.4-0.4-0.7-0.4-0.2-1-0.4l-1.2-0.4q-0.6-0.1-1-0.6-0.4-0.5-0.4-1.2 0-0.9 0.7-1.5 0.7-0.6 1.8-0.6 0.9 0 1.6 0.4 0.7 0.4 1 1.1l-1 0.6q-0.4-1-1.6-1-0.5 0-0.9 0.3-0.3 0.2-0.3 0.7zm9-0.7h-1.9v3.9q0 0.5 0.2 0.8 0.2 0.2 0.6 0.2 0.5 0 1.1 0v1.1q-1.6 0.2-2.4-0.3-0.8-0.5-0.8-1.8v-3.9h-1.4v-1.2h1.4