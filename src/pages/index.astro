		</header>

		<footer class="pointer-events-none fixed inset-x-0 bottom-2 z-30 flex justify-center" data-brand-chrome>
			<p class="footer-text whitespace-nowrap px-4 text-[clamp(0.625rem,2.3vw,0.6875rem)] font-medium tracking-wide">
				© 2026 OhKey Estrategias Digitales · Hecho con estrategia, no con suerte.
			</p>
		</footer>

		<WhatsAppBubble />

		<div id="interactive-bg" class="fixed inset-0 z-0 pointer-events-none"></div>

		<main id="slider" class="fixed inset-0 overflow-hidden bg-white text-white">
